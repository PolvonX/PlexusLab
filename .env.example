# ============================================================
#  Plexus Lab :: Cortex — секреты окружения
#  Скопируй в .env и заполни. Файл .env в git НЕ коммитится.
# ============================================================

# Токен бота-шлюза @Cortex (создать в @BotFather).
# ВАЖНО: в BotFather выключи privacy mode для этого бота:
#   /mybots -> Cortex -> Bot Settings -> Group Privacy -> Turn off
# Иначе Cortex не увидит сообщения в корпоративной группе.
CORTEX_BOT_TOKEN=

# Telegram ID CEO (Abdulloh Abbosov). Система реагирует ТОЛЬКО на него
# и на ботов из employees_registry.json. Узнать ID: напиши @userinfobot.
CEO_TELEGRAM_ID=

# ID корпоративной рабочей группы (отрицательное число, напр. -1001234567890).
# Можно оставить пустым: Cortex подскажет ID при первом сообщении в группе.
CORP_GROUP_ID=

# Необязательно: приватный чат CEO для отчётов Synapse.
# Если пусто — используется CEO_TELEGRAM_ID.
CEO_DM_CHAT_ID=

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
